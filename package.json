{
  "name": "powersync-native-shell-demo",
  "license": "CC0-1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "setup": "node scripts/setup-env.mjs",
    "ps": "node --env-file=.env node_modules/powersync/bin/run.js",
    "migrate": "pnpm --filter powerbin-server migrate",
    "test": "pnpm --filter powerbin-server test && pnpm --filter powerbin-web-sync test",
    "test:integration": "pnpm --filter powerbin-server test:integration",
    "cli:build": "pnpm --filter powerbin build",
    "cli:test": "pnpm --filter powerbin test",
    "server": "pnpm --filter powerbin-server start",
    "web:build": "pnpm --filter powerbin-web-sync build && nsh package app --target web && node scripts/copy-web-assets.mjs"
  },
  "devDependencies": {
    "powersync": "^0.10.3"
  }
}
