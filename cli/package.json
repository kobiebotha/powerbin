{
  "name": "powerbin",
  "version": "0.1.1",
  "description": "Reveal and burn PowerBin one-time messages from your terminal, with local decryption.",
  "license": "CC0-1.0",
  "type": "module",
  "bin": {
    "powerbin": "dist/index.js"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.cjs",
    "dist/**/*.wasm",
    "dist/**/*.d.ts",
    "dist/**/*.d.cts",
    "THIRD_PARTY_NOTICES.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kobiebotha/powersync-native-shell-demo.git",
    "directory": "cli"
  },
  "keywords": ["powerbin", "cli", "one-time", "encrypted", "secret-sharing"],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "pnpm run build:crypto && pnpm run build:notices && pnpm run build:ts",
    "build:crypto": "node scripts/build-crypto.mjs",
    "build:notices": "node scripts/build-notices.mjs",
    "build:ts": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/*.test.mjs",
    "prepack": "pnpm run build"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  }
}
